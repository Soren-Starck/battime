#!/bin/zsh
# battime: your Mac's battery time remaining, power draw and health, in the terminal.
# https://github.com/Soren-Starck/battime  (MIT)
#
# Reads only what macOS already reports: `pmset -g batt` for the time estimate, the AppleSmartBattery
# registry entry (ioreg) for voltage, current and cycles, and System Information for health.
# No root, no dependencies, nothing written to disk.

emulate -L zsh
# Decimal points whatever the user's region (fr_FR printed "6,2" and broke the JSON).
export LC_ALL=C

VERSION=1.0.0

usage() {
  print -r -- "battime: battery time remaining, power draw and health for Mac laptops

Usage:
  battime            one summary
  battime --watch    refresh every 5 seconds (battime --watch 2 for every 2 seconds)
  battime --json     machine-readable output
  battime --help     this help
  battime --version

The time estimate is the one macOS computes (pmset). It follows your current load, so it moves as you work."
}

# ioreg prints a negative current as an unsigned 64-bit number (18446744073709550992 is -624). That overflows zsh's
# integers, so the conversion goes through bc.
signed() {
  local v=${1:-0}
  if (( ${#v} >= 19 )); then print -r -- "$(print -r -- "$v - 18446744073709551616" | bc)"; else print -r -- "$v"; fi
}

ioreg_value() { print -r -- "$IOREG" | awk -v k="\"$1\"" '$0 ~ "^[ |]*"k" = " { sub(/.* = /, ""); print; exit }' }

fmt_minutes() {
  local m=$1
  (( m < 0 )) && { print -r -- "unknown"; return }
  printf '%dh %02dm' $(( m / 60 )) $(( m % 60 ))
}

read_battery() {
  IOREG=$(ioreg -rn AppleSmartBattery 2>/dev/null) || IOREG=""
  if [[ -z $IOREG || $(ioreg_value BatteryInstalled) != Yes ]]; then
    return 1
  fi
  PMSET=$(pmset -g batt 2>/dev/null | awk '/InternalBattery/ { sub(/^[^\t]*\t/, ""); print; exit }')
  PERCENT=$(print -r -- "$PMSET" | awk -F';' '{ gsub(/[ %]/, "", $1); print $1 }')
  STATE=$(print -r -- "$PMSET" | awk -F';' '{ gsub(/^ +| +$/, "", $2); print $2 }')
  local t=$(print -r -- "$PMSET" | awk -F';' '{ print $3 }' | grep -o -E '[0-9]+:[0-9]{2}' | head -1)
  if [[ -n $t && $t != 0:00 ]]; then MINUTES=$(( ${t%%:*} * 60 + ${t##*:} )); else MINUTES=-1; fi
  EXTERNAL=$(ioreg_value ExternalConnected)
  VOLTAGE_MV=$(ioreg_value Voltage)
  AMPERAGE_MA=$(signed "$(ioreg_value InstantAmperage)")
  CYCLES=$(ioreg_value CycleCount)
  DESIGN_CYCLES=$(ioreg_value DesignCycleCount9C)
  # AvgTimeToEmpty, not TimeRemaining: TimeRemaining turns into the time to full while charging.
  local own=$(ioreg_value AvgTimeToEmpty)
  BATTERY_MINUTES=-1
  [[ $own == <-> ]] && (( own > 0 && own < 65535 )) && BATTERY_MINUTES=$own
  WATTS=$(awk -v v="$VOLTAGE_MV" -v a="$AMPERAGE_MA" 'BEGIN { w = v * a / 1e6; if (w < 0) w = -w; printf "%.1f", w }')
  return 0
}

# Condition and maximum capacity cannot change in seconds, so --watch reads them once.
read_health() {
  local sp=$(system_profiler SPPowerDataType 2>/dev/null)
  CONDITION=$(print -r -- "$sp" | awk -F': ' '/^ *Condition:/ { print $2; exit }')
  MAXCAP=$(print -r -- "$sp" | awk -F': ' '/^ *Maximum Capacity:/ { gsub(/[^0-9]/, "", $2); print $2; exit }')
}

state_words() {
  case $STATE in
    discharging) [[ $EXTERNAL == Yes ]] && print -r -- "plugged in, discharging" || print -r -- "on battery" ;;
    charging) print -r -- "charging" ;;
    charged) print -r -- "fully charged" ;;
    "finishing charge") print -r -- "finishing charge" ;;
    *) [[ $EXTERNAL == Yes ]] && print -r -- "plugged in, not charging" || print -r -- "$STATE" ;;
  esac
}

summary() {
  local line="${PERCENT}% · $(state_words)"
  if (( MINUTES >= 0 )); then
    case $STATE in
      discharging) line+=" · $(fmt_minutes $MINUTES) left (macOS estimate)" ;;
      charging|"finishing charge") line+=" · $(fmt_minutes $MINUTES) to full (macOS estimate)" ;;
    esac
  elif [[ $STATE == discharging ]]; then
    line+=" · macOS is still calculating the estimate"
  fi
  print -r -- "$line"
  if (( AMPERAGE_MA < 0 )); then
    printf 'Drawing %s W from the battery (%.2f V, %d mA)\n' "$WATTS" $(( VOLTAGE_MV / 1000.0 )) $(( -AMPERAGE_MA ))
  elif (( AMPERAGE_MA > 0 )); then
    printf 'Charging at %s W (%.2f V, %d mA)\n' "$WATTS" $(( VOLTAGE_MV / 1000.0 )) $AMPERAGE_MA
  fi
  local health="Health: ${CONDITION:-unknown}"
  [[ -n ${MAXCAP:-} ]] && health+=" · maximum capacity ${MAXCAP}%"
  [[ -n ${CYCLES:-} ]] && health+=" · ${CYCLES} cycles${DESIGN_CYCLES:+ of ${DESIGN_CYCLES} rated}"
  print -r -- "$health"
}

json() {
  local q='"'
  printf '{"percent":%s,"state":"%s","external_power":%s,"time_remaining_minutes":%s,"time_source":"pmset","battery_time_to_empty_minutes":%s,"power_watts":%s,"voltage_mv":%s,"current_ma":%s,"cycle_count":%s,"design_cycle_count":%s,"condition":%s,"maximum_capacity_percent":%s}\n' \
    "${PERCENT:-null}" "$STATE" "$([[ $EXTERNAL == Yes ]] && print true || print false)" \
    "$( (( MINUTES >= 0 )) && print $MINUTES || print null)" \
    "$( (( BATTERY_MINUTES >= 0 )) && print $BATTERY_MINUTES || print null)" \
    "$WATTS" "${VOLTAGE_MV:-null}" "$AMPERAGE_MA" "${CYCLES:-null}" "${DESIGN_CYCLES:-null}" \
    "$([[ -n ${CONDITION:-} ]] && print -r -- "$q$CONDITION$q" || print null)" "${MAXCAP:-null}"
}

no_battery() { print -u2 -- "battime: no internal battery found (desktop Mac or virtual machine)."; exit 1 }

case ${1:-} in
  -h|--help) usage ;;
  -v|--version) print -r -- "battime $VERSION" ;;
  --json) read_battery || no_battery; read_health; json ;;
  -w|--watch)
    local every=${2:-5}
    [[ $every == <-> && $every -ge 1 ]] || { print -u2 -- "battime: --watch takes a whole number of seconds"; exit 2 }
    trap 'print; exit 0' INT
    read_battery || no_battery; read_health
    while true; do
      read_battery || no_battery
      print -n -- $'\e[H\e[2J'
      summary
      print -r -- ""
      print -r -- "Refreshing every ${every}s. Ctrl-C to stop."
      sleep $every
    done ;;
  "") read_battery || no_battery; read_health; summary ;;
  *) print -u2 -- "battime: unknown option $1"; usage >&2; exit 2 ;;
esac
